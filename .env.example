# TEKMERION Configuration
# Copy this file to .env and fill in the actual values.

# Search API
TEKMERION_SEARCH_API_KEY=your_api_key_here
TEKMERION_SEARCH_ENDPOINT=https://api.searchprovider.com/v1

# Ethereum / Blockchain
ETH_RPC_URL=https://sepolia.infura.io/v3/your_project_id
ETH_PRIVATE_KEY=0xyour_private_key_here
EVIDENCE_CONTRACT_ADDRESS=0xYourContractAddressHere

# Face Worker
FACE_WORKER_PATH=./workers/face/worker.py

# Pipeline Tuning
FACE_SIMILARITY_THRESHOLD=0.80
MAX_CANDIDATES=20
MAX_DOWNLOAD_BYTES=10485760
HTTP_TIMEOUT_SECONDS=30

# Filesystem
CACHE_DIRECTORY=./.tekmerion/cache
RUN_DIRECTORY=./runs
