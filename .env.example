# ============================================================
# TEKMERION Configuration
# ============================================================

# ============================================================
# SEARCH / REVERSE IMAGE DISCOVERY
# Provider: SerpApi Google Lens
# ============================================================

TEKMERION_SEARCH_API_KEY=eedc9ec36987c385f7bf3e33e90fc1867e83bb7b00b5e08f3e369095036bd838

TEKMERION_SEARCH_ENDPOINT=https://serpapi.com/search?engine=google_lens


# ============================================================
# ETHEREUM / BLOCKCHAIN
# Network: Ethereum Sepolia
# Chain ID: 11155111
# ============================================================

ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

ETH_PRIVATE_KEY=0xYOUR_SEPOLIA_TEST_WALLET_PRIVATE_KEY

EVIDENCE_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_EVIDENCE_REGISTRY_ADDRESS


# ============================================================
# FACE ANALYSIS WORKER
# Python + ONNX Runtime + SCRFD + ArcFace
# ============================================================

FACE_WORKER_PATH=./workers/face/worker.py


# ============================================================
# PIPELINE TUNING
# ============================================================

# Initial ArcFace cosine-similarity decision threshold
FACE_SIMILARITY_THRESHOLD=0.80

# Maximum candidates processed per discovery run
MAX_CANDIDATES=20

# Maximum downloaded candidate image size: 10 MB
MAX_DOWNLOAD_BYTES=10485760

# HTTP request timeout
HTTP_TIMEOUT_SECONDS=30


# ============================================================
# FILESYSTEM
# ============================================================

CACHE_DIRECTORY=./.tekmerion/cache

RUN_DIRECTORY=./runs
